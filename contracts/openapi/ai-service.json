{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Service Contract API",
    "description": "AI Service for Resume Parsing, Feature Extraction, Rubric Scoring, JD Matching, and Ollama Hybrid Enrichment.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/extract-features": {
      "post": {
        "tags": [
          "Extraction"
        ],
        "summary": "Extract Features",
        "operationId": "extract_features_api_extract_features_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze-resume": {
      "post": {
        "tags": [
          "Resume Analysis"
        ],
        "summary": "Analyze resume PDF",
        "description": "Analyze resume PDF: validate, extract features, compute rubric scores and enrich with LLM.",
        "operationId": "analyze_resume_api_analyze_resume_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_resume_api_analyze_resume_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeAnalysisResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze-match": {
      "post": {
        "tags": [
          "Matching"
        ],
        "summary": "Match resume with job description",
        "description": "Match resume features against job description skills and ATS criteria.",
        "operationId": "analyze_match_api_analyze_match_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_match_api_analyze_match_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiMetadata": {
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/AiProvider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "usedFallback": {
            "type": "boolean",
            "title": "Usedfallback"
          },
          "processingMs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Processingms"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model",
          "usedFallback",
          "processingMs"
        ],
        "title": "AiMetadata"
      },
      "AiProvider": {
        "type": "string",
        "enum": [
          "OLLAMA",
          "RULE_BASED"
        ],
        "title": "AiProvider"
      },
      "Body_analyze_match_api_analyze_match_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "Resume PDF file (max 5 MB)"
          },
          "jdFile": {
            "anyOf": [
              {
                "type": "string",
                "format": "binary"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jdfile",
            "description": "Job description PDF file (max 5 MB, optional if jobDescription is provided)"
          },
          "jobDescription": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Jobdescription",
            "description": "Job description text (min 50 characters, optional if jdFile is provided)"
          },
          "targetRole": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Targetrole",
            "description": "Target role name (optional)"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_match_api_analyze_match_post"
      },
      "Body_analyze_resume_api_analyze_resume_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "Resume PDF file (max 5 MB)"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_resume_api_analyze_resume_post"
      },
      "ExtractRequest": {
        "properties": {
          "fileName": {
            "type": "string",
            "title": "Filename"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "pageCount": {
            "type": "integer",
            "title": "Pagecount"
          },
          "sizeBytes": {
            "type": "integer",
            "title": "Sizebytes"
          }
        },
        "type": "object",
        "required": [
          "fileName",
          "text",
          "pageCount",
          "sizeBytes"
        ],
        "title": "ExtractRequest"
      },
      "ExtractResponse": {
        "properties": {
          "candidateName": {
            "type": "string",
            "title": "Candidatename"
          },
          "candidateEmail": {
            "type": "string",
            "title": "Candidateemail"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills"
          },
          "predictedField": {
            "type": "string",
            "title": "Predictedfield"
          },
          "fieldEvidence": {
            "items": {
              "$ref": "#/components/schemas/app__extraction__router__FieldEvidence"
            },
            "type": "array",
            "title": "Fieldevidence"
          }
        },
        "type": "object",
        "required": [
          "candidateName",
          "candidateEmail",
          "skills",
          "predictedField",
          "fieldEvidence"
        ],
        "title": "ExtractResponse"
      },
      "FieldEnum": {
        "type": "string",
        "enum": [
          "Data Science",
          "Web Development",
          "Android Development",
          "iOS Development",
          "UI/UX",
          "Unknown"
        ],
        "title": "FieldEnum"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "healthy"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "qwen3:4b"
          },
          "ollamaReachable": {
            "type": "boolean",
            "title": "Ollamareachable",
            "default": false
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "MatchResult": {
        "properties": {
          "fileName": {
            "type": "string",
            "title": "Filename"
          },
          "jdFileName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jdfilename",
            "description": "Job description file name"
          },
          "targetRole": {
            "type": "string",
            "title": "Targetrole"
          },
          "matchScore": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Matchscore"
          },
          "matchedSkills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matchedskills"
          },
          "missingSkills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missingskills"
          },
          "atsKeywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 15,
            "title": "Atskeywords"
          },
          "strengths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Strengths"
          },
          "weaknesses": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Weaknesses"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Recommendations"
          },
          "ai": {
            "$ref": "#/components/schemas/AiMetadata"
          }
        },
        "type": "object",
        "required": [
          "fileName",
          "targetRole",
          "matchScore",
          "ai"
        ],
        "title": "MatchResult"
      },
      "ResumeAnalysisResult": {
        "properties": {
          "fileName": {
            "type": "string",
            "title": "Filename"
          },
          "candidateName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidatename"
          },
          "candidateEmail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidateemail"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills"
          },
          "predictedField": {
            "$ref": "#/components/schemas/FieldEnum"
          },
          "fieldEvidence": {
            "items": {
              "$ref": "#/components/schemas/app__schemas__features__FieldEvidence"
            },
            "type": "array",
            "title": "Fieldevidence"
          },
          "resumeScore": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Resumescore"
          },
          "scoreBreakdown": {
            "$ref": "#/components/schemas/ScoreBreakdown"
          },
          "recommendedSkills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Recommendedskills"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Recommendations"
          },
          "ai": {
            "$ref": "#/components/schemas/AiMetadata"
          }
        },
        "type": "object",
        "required": [
          "fileName",
          "predictedField",
          "resumeScore",
          "scoreBreakdown",
          "ai"
        ],
        "title": "ResumeAnalysisResult"
      },
      "ScoreBreakdown": {
        "properties": {
          "contact": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Contact"
          },
          "summary": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Summary"
          },
          "skills": {
            "type": "integer",
            "maximum": 15.0,
            "minimum": 0.0,
            "title": "Skills"
          },
          "education": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Education"
          },
          "experience": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Experience"
          },
          "projects": {
            "type": "integer",
            "maximum": 15.0,
            "minimum": 0.0,
            "title": "Projects"
          },
          "achievementsCertifications": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Achievementscertifications"
          },
          "quantifiedImpact": {
            "type": "integer",
            "maximum": 15.0,
            "minimum": 0.0,
            "title": "Quantifiedimpact"
          },
          "total": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "contact",
          "summary",
          "skills",
          "education",
          "experience",
          "projects",
          "achievementsCertifications",
          "quantifiedImpact",
          "total"
        ],
        "title": "ScoreBreakdown"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "app__extraction__router__FieldEvidence": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "matchedSkills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matchedskills"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "field",
          "matchedSkills",
          "confidence"
        ],
        "title": "FieldEvidence"
      },
      "app__schemas__features__FieldEvidence": {
        "properties": {
          "field": {
            "$ref": "#/components/schemas/FieldEnum"
          },
          "matchedSkills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matchedskills"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "field",
          "confidence"
        ],
        "title": "FieldEvidence"
      }
    }
  }
}
