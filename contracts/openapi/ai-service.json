{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Service Contract API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/extract-features": {
      "post": {
        "tags": [
          "Extraction"
        ],
        "summary": "Extract Features",
        "operationId": "extract_features_api_extract_features_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze-match": {
      "post": {
        "tags": [
          "Matching"
        ],
        "summary": "Match resume with job description",
        "description": "Match resume features against job description skills and ATS criteria.",
        "operationId": "analyze_match_api_analyze_match_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_match_api_analyze_match_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiMetadata": {
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/AiProvider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "usedFallback": {
            "type": "boolean",
            "title": "Usedfallback"
          },
          "processingMs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Processingms"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model",
          "usedFallback",
          "processingMs"
        ],
        "title": "AiMetadata"
      },
      "AiProvider": {
        "type": "string",
        "enum": [
          "OLLAMA",
          "RULE_BASED"
        ],
        "title": "AiProvider"
      },
      "Body_analyze_match_api_analyze_match_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Resume PDF file (max 5 MB)"
          },
          "jobDescription": {
            "type": "string",
            "minLength": 50,
            "title": "Jobdescription",
            "description": "Job description text"
          },
          "targetRole": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Targetrole",
            "description": "Target role name (optional)"
          }
        },
        "type": "object",
        "required": [
          "file",
          "jobDescription"
        ],
        "title": "Body_analyze_match_api_analyze_match_post"
      },
      "ExtractRequest": {
        "properties": {
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          }
        },
        "type": "object",
        "required": [
          "file_name",
          "text",
          "page_count",
          "size_bytes"
        ],
        "title": "ExtractRequest"
      },
      "ExtractResponse": {
        "properties": {
          "predicted_field": {
            "type": "string",
            "title": "Predicted Field"
          },
          "field_evidence": {
            "items": {
              "$ref": "#/components/schemas/FieldEvidence"
            },
            "type": "array",
            "title": "Field Evidence"
          }
        },
        "type": "object",
        "required": [
          "predicted_field",
          "field_evidence"
        ],
        "title": "ExtractResponse"
      },
      "FieldEvidence": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "matched_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Skills"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "field",
          "matched_skills",
          "confidence"
        ],
        "title": "FieldEvidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchResult": {
        "properties": {
          "fileName": {
            "type": "string",
            "title": "Filename"
          },
          "targetRole": {
            "type": "string",
            "title": "Targetrole"
          },
          "matchScore": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Matchscore"
          },
          "matchedSkills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matchedskills"
          },
          "missingSkills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missingskills"
          },
          "atsKeywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 15,
            "title": "Atskeywords"
          },
          "strengths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Strengths"
          },
          "weaknesses": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Weaknesses"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Recommendations"
          },
          "ai": {
            "$ref": "#/components/schemas/AiMetadata"
          }
        },
        "type": "object",
        "required": [
          "fileName",
          "targetRole",
          "matchScore",
          "ai"
        ],
        "title": "MatchResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}