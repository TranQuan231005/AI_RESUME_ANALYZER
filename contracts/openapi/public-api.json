{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Resume Analyzer - Public API",
    "description": "Public backend API for Authentication, Resume Analysis, Job Matching, User History, and Admin Dashboard.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user and get JWT access token",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Get current authenticated user info",
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/resume": {
      "post": {
        "summary": "Upload resume PDF and analyze",
        "operationId": "analyzeResume",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Resume PDF file (max 5 MB)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resume analyzed successfully and persisted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersistedResumeAnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "File too large (> 5 MB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable PDF (invalid format, encrypted, unreadable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "AI service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/match": {
      "post": {
        "summary": "Match resume PDF with job description",
        "operationId": "matchResume",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Resume PDF file (max 5 MB)"
                  },
                  "jdFile": {
                    "type": "string",
                    "format": "binary",
                    "nullable": true,
                    "description": "Job description PDF file (max 5 MB, optional if jobDescription is provided)"
                  },
                  "jobDescription": {
                    "type": "string",
                    "minLength": 50,
                    "nullable": true,
                    "description": "Job description text (min 50 characters, optional if jdFile is provided)"
                  },
                  "targetRole": {
                    "type": "string",
                    "nullable": true,
                    "description": "Target job title (optional)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resume matched successfully and persisted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersistedMatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "File too large (> 5 MB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable PDF or JD too short",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "AI service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses": {
      "get": {
        "summary": "Get user analysis history with pagination",
        "operationId": "getUserAnalyses",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["RESUME", "MATCH"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged list of user analysis summaries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedAnalysisSummary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/{id}": {
      "get": {
        "summary": "Get analysis detail by ID (owned by caller)",
        "operationId": "getAnalysisDetail",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Analysis result detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (IDOR protection)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Analysis not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "summary": "Admin: List users with pagination",
        "operationId": "adminGetUsers",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedUsers"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - requires ADMIN role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/analyses": {
      "get": {
        "summary": "Admin: List all system analyses with filters",
        "operationId": "adminGetAnalyses",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["RESUME", "MATCH"]
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["OLLAMA", "RULE_BASED"]
            }
          },
          {
            "name": "usedFallback",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged system analyses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedAdminAnalyses"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - requires ADMIN role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/metrics": {
      "get": {
        "summary": "Admin: Get AI and system operational metrics",
        "operationId": "adminGetMetrics",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "AI operational metrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMetricsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - requires ADMIN role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "PublicHealthResponse": {
        "type": "object",
        "required": ["status", "database", "aiService"],
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "database": {
            "type": "string",
            "example": "UP"
          },
          "aiService": {
            "type": "string",
            "example": "UP"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.test"
          },
          "password": {
            "type": "string",
            "example": "User@123456"
          }
        }
      },
      "UserDto": {
        "type": "object",
        "required": ["id", "email", "fullName", "role"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "email": {
            "type": "string",
            "example": "user@example.test"
          },
          "fullName": {
            "type": "string",
            "example": "Demo User"
          },
          "role": {
            "type": "string",
            "enum": ["USER", "ADMIN"],
            "example": "USER"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["accessToken", "tokenType", "expiresIn", "user"],
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "example": 7200
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "FieldEnum": {
        "type": "string",
        "enum": [
          "Data Science",
          "Web Development",
          "Android Development",
          "iOS Development",
          "UI/UX",
          "Unknown"
        ]
      },
      "FieldEvidence": {
        "type": "object",
        "required": ["field", "matchedSkills", "confidence"],
        "properties": {
          "field": {
            "$ref": "#/components/schemas/FieldEnum"
          },
          "matchedSkills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      },
      "ScoreBreakdown": {
        "type": "object",
        "required": [
          "contact",
          "summary",
          "skills",
          "education",
          "experience",
          "projects",
          "achievementsCertifications",
          "quantifiedImpact",
          "total"
        ],
        "properties": {
          "contact": { "type": "integer", "minimum": 0, "maximum": 5 },
          "summary": { "type": "integer", "minimum": 0, "maximum": 10 },
          "skills": { "type": "integer", "minimum": 0, "maximum": 15 },
          "education": { "type": "integer", "minimum": 0, "maximum": 10 },
          "experience": { "type": "integer", "minimum": 0, "maximum": 20 },
          "projects": { "type": "integer", "minimum": 0, "maximum": 15 },
          "achievementsCertifications": { "type": "integer", "minimum": 0, "maximum": 10 },
          "quantifiedImpact": { "type": "integer", "minimum": 0, "maximum": 15 },
          "total": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      },
      "AiMetadata": {
        "type": "object",
        "required": ["provider", "model", "usedFallback", "processingMs"],
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["OLLAMA", "RULE_BASED"]
          },
          "model": {
            "type": "string"
          },
          "usedFallback": {
            "type": "boolean"
          },
          "processingMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ResumeAnalysisResult": {
        "type": "object",
        "required": [
          "fileName",
          "candidateName",
          "candidateEmail",
          "skills",
          "predictedField",
          "fieldEvidence",
          "resumeScore",
          "scoreBreakdown",
          "recommendedSkills",
          "recommendations",
          "ai"
        ],
        "properties": {
          "fileName": { "type": "string" },
          "candidateName": { "type": "string", "nullable": true },
          "candidateEmail": { "type": "string", "nullable": true },
          "skills": { "type": "array", "items": { "type": "string" } },
          "predictedField": { "$ref": "#/components/schemas/FieldEnum" },
          "fieldEvidence": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FieldEvidence" }
          },
          "resumeScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "scoreBreakdown": { "$ref": "#/components/schemas/ScoreBreakdown" },
          "recommendedSkills": { "type": "array", "items": { "type": "string" } },
          "recommendations": { "type": "array", "items": { "type": "string" } },
          "ai": { "$ref": "#/components/schemas/AiMetadata" }
        }
      },
      "MatchResult": {
        "type": "object",
        "required": [
          "fileName",
          "targetRole",
          "matchScore",
          "matchedSkills",
          "missingSkills",
          "atsKeywords",
          "strengths",
          "weaknesses",
          "recommendations",
          "ai"
        ],
        "properties": {
          "fileName": { "type": "string" },
          "jdFileName": { "type": "string", "nullable": true },
          "targetRole": { "type": "string" },
          "matchScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "matchedSkills": { "type": "array", "items": { "type": "string" } },
          "missingSkills": { "type": "array", "items": { "type": "string" } },
          "atsKeywords": { "type": "array", "items": { "type": "string" } },
          "strengths": { "type": "array", "items": { "type": "string" } },
          "weaknesses": { "type": "array", "items": { "type": "string" } },
          "recommendations": { "type": "array", "items": { "type": "string" } },
          "ai": { "$ref": "#/components/schemas/AiMetadata" }
        }
      },
      "PersistedResumeAnalysisResponse": {
        "type": "object",
        "required": ["id", "createdAt", "result"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "createdAt": { "type": "string", "format": "date-time" },
          "result": { "$ref": "#/components/schemas/ResumeAnalysisResult" }
        }
      },
      "PersistedMatchResponse": {
        "type": "object",
        "required": ["id", "createdAt", "result"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "createdAt": { "type": "string", "format": "date-time" },
          "result": { "$ref": "#/components/schemas/MatchResult" }
        }
      },
      "AnalysisSummaryDto": {
        "type": "object",
        "required": [
          "id",
          "analysisType",
          "fileName",
          "candidateName",
          "predictedField",
          "resumeScore",
          "matchScore",
          "targetRole",
          "aiProvider",
          "usedFallback",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "analysisType": { "type": "string", "enum": ["RESUME", "MATCH"] },
          "fileName": { "type": "string" },
          "candidateName": { "type": "string", "nullable": true },
          "predictedField": { "type": "string", "nullable": true },
          "resumeScore": { "type": "integer", "nullable": true },
          "matchScore": { "type": "integer", "nullable": true },
          "targetRole": { "type": "string", "nullable": true },
          "aiProvider": { "type": "string" },
          "usedFallback": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "PagedAnalysisSummary": {
        "type": "object",
        "required": ["items", "page", "size", "totalItems", "totalPages"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnalysisSummaryDto" }
          },
          "page": { "type": "integer" },
          "size": { "type": "integer" },
          "totalItems": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer" }
        }
      },
      "AnalysisDetailResponse": {
        "type": "object",
        "required": ["id", "analysisType", "fileName", "createdAt", "resultJson"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "analysisType": { "type": "string", "enum": ["RESUME", "MATCH"] },
          "fileName": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "resultJson": { "type": "object" }
        }
      },
      "PagedUsers": {
        "type": "object",
        "required": ["items", "page", "size", "totalItems", "totalPages"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UserDto" }
          },
          "page": { "type": "integer" },
          "size": { "type": "integer" },
          "totalItems": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer" }
        }
      },
      "PagedAdminAnalyses": {
        "type": "object",
        "required": ["items", "page", "size", "totalItems", "totalPages"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnalysisSummaryDto" }
          },
          "page": { "type": "integer" },
          "size": { "type": "integer" },
          "totalItems": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer" }
        }
      },
      "AdminMetricsResponse": {
