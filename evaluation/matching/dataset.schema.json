{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResumeJobMatchingEvaluationDatasetSchema",
  "type": "object",
  "required": [
    "id",
    "resumeText",
    "jdText",
    "targetRole",
    "domain",
    "humanMatchScore",
    "requiredSkills",
    "preferredSkills",
    "scenarioType",
    "explanation",
    "reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pair-[a-z0-9-]+$"
    },
    "resumeText": {
      "type": "string",
      "minLength": 30
    },
    "jdText": {
      "type": "string",
      "minLength": 30
    },
    "targetRole": {
      "type": "string",
      "minLength": 2
    },
    "domain": {
      "type": "string",
      "enum": [
        "Data Science",
        "Web Development",
        "Android Development",
        "iOS Development",
        "UI/UX",
        "Cross-Domain"
      ]
    },
    "humanMatchScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "requiredSkills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preferredSkills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scenarioType": {
      "type": "string",
      "enum": [
        "standard_match",
        "partial_match",
        "paraphrase_match",
        "missing_required_skill",
        "keyword_stuffing",
        "cross_domain",
        "no_skills_jd"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 10
    },
    "reviewed": {
      "type": "boolean",
      "enum": [true]
    }
  },
  "additionalProperties": false
}
