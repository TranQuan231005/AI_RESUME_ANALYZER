{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResumeJobMatchingEvaluationDatasetSchema",
  "type": "object",
  "required": [
    "id",
    "resumeText",
    "jdText",
    "targetRole",
    "domain",
    "provisionalScore",
    "requiredSkills",
    "preferredSkills",
    "scenarioType",
    "explanation",
    "templateGroup",
    "split",
    "reviewerScores",
    "adjudicatedScore",
    "reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pair-[a-z0-9-]+$"
    },
    "resumeText": {
      "type": "string",
      "minLength": 30
    },
    "jdText": {
      "type": "string",
      "minLength": 30
    },
    "targetRole": {
      "type": "string",
      "minLength": 2
    },
    "domain": {
      "type": "string",
      "enum": [
        "Data Science",
        "Web Development",
        "Android Development",
        "iOS Development",
        "UI/UX",
        "Cross-Domain"
      ]
    },
    "provisionalScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Synthetic authoring target; never used as human ground truth"
    },
    "requiredSkills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preferredSkills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scenarioType": {
      "type": "string",
      "enum": [
        "standard_match",
        "partial_match",
        "paraphrase_match",
        "missing_required_skill",
        "keyword_stuffing",
        "cross_domain",
        "no_skills_jd"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 10
    },
    "reviewed": {
      "type": "boolean"
    },
    "templateGroup": {
      "type": "string",
      "minLength": 3
    },
    "split": {
      "type": "string",
      "enum": ["calibration", "test"]
    },
    "reviewerScores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewerId", "score"],
        "properties": {
          "reviewerId": {"type": "string"},
          "score": {"type": "integer", "minimum": 0, "maximum": 100}
        },
        "additionalProperties": false
      }
    },
    "adjudicatedScore": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100
    }
  },
  "additionalProperties": false
}
